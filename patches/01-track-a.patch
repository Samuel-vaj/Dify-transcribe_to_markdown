+                    path = "…" + path[-self._max_heading_path_chars :]
+                out.append(f"{_HEADING_PATH_PREFIX}{path}")
+
+            out.append(line)
+
+            # 跳过标题后面的空行，让「章节路径 + 标题 + 首个内容块」落在同一片段内
+            next_index = index + 1
+            while next_index < len(lines) and not lines[next_index].strip():
